# Token secreto para proteger el acceso a tu servidor MCP en Vercel
# Puedes generar uno seguro en tu terminal con: openssl rand -hex 32
BRIDGE_AUTH_TOKEN=tu_clave_secreta_super_segura_aqui

# GitHub Personal Access Token (PAT)
# Genéralo en GitHub > Settings > Developer Settings > Personal Access Tokens
# Scopes recomendados: 'repo', 'read:org', 'user' (o Fine-grained tokens con permisos de Repositories)
GITHUB_PERSONAL_ACCESS_TOKEN=ghp_tu_token_personal_de_github_aqui

# Telegram Bot Token
# Obtenlo hablando con @BotFather en Telegram creando un nuevo bot (/newbot)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# Telegram Chat ID por defecto (opcional si se pasa chat_id como argumento en las herramientas)
# Para obtener tu ID personal, envía cualquier mensaje a @userinfobot en Telegram
TELEGRAM_DEFAULT_CHAT_ID=123456789

# Notion API Key (Internal Integration Token)
# Créalo en https://www.notion.so/profile/integrations > New integration
# Recuerda invitar/conectar la integración en las páginas o bases de datos que quieras compartir.
NOTION_API_KEY=ntn_tu_clave_de_integracion_de_notion_aqui

